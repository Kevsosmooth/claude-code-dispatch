{
  "description": "claude-code-dispatch: model routing gate, orchestrator gate and tripwire, direct-mode override, usage snapshot",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/usage-snapshot.sh\"", "async": true}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/direct-mode.sh\""}]}
    ],
    "PreToolUse": [
      {"matcher": "Agent",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-gate.sh\"", "timeout": 20}]},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-gate.sh\"", "timeout": 20}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-tripwire.sh\"", "timeout": 20}]}
    ]
  }
}
